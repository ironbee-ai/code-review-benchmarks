# Copy to .env (never committed). Keys are read from the environment only; nothing in configs/ holds a secret.
export AWS_REGION=us-west-2
export AWS_BEARER_TOKEN_BEDROCK=
export OPENROUTER_API_KEY=
# GitHub token for building the PR snapshot (falls back to `gh auth token`)
export GITHUB_TOKEN=
# Optional: a second env file to read before this one (e.g. a sibling repo's .env)
# export CRBENCH_ENV_FILE=/path/to/another/.env
